tom-auth","instance":"metronic-react"},{"title":"Dark Mode","description":"How to use dark mode features in Metronic React.","published":true,"featured":false,"component":false,"toc":true,"body":{"raw":"\\nMetronic React provides built-in dark mode support using [next-themes](https://github.com/pacocoursey/next-themes). For details on the theme provider implementation, see the [Providers guide](/metronic-react/guides/providers).\\n\\n## Basic Usage\\n\\n```tsx\\nimport { useTheme } from \'next-themes\';\\n\\nfunction DarkModeToggle() {\\n  const { theme, setTheme } = useTheme();\\n\\n  return (\\n    <button\\n      onClick={() => setTheme(theme === \'dark\' ? \'light\' : \'dark\')}\\n    >\\n      {theme === \'dark\' ? \'Switch to Light\' : \'Switch to Dark\'}\\n    </button>\\n  );\\n}\\n```\\n\\n## Theme Options\\n\\n```tsx\\nfunction ThemeSelector() {\\n  const { theme, setTheme } = useTheme();\\n\\n  return (\\n    <select value={theme} onChange={(e) => setTheme(e.target.value)}>\\n      <option value=\\"light\\">Light</option>\\n      <option value=\\"dark\\">Dark</option>\\n      <option value=\\"system\\">System</option>\\n    </select>\\n  );\\n}\\n```\\n\\n## Using `resolvedTheme`\\n\\nWhen working with the system theme, use `resolvedTheme` for accurate styling:\\n\\n```tsx\\nfunction ThemeAwareComponent() {\\n  const { resolvedTheme } = useTheme();\\n\\n  return (\\n    <div className=\\"p-4 rounded-lg shadow-md\\">\\n      {resolvedTheme === \'dark\' ? (\\n        <span className=\\"text-blue-300\\">Dark mode content</span>\\n      ) : (\\n        <span className=\\"text-blue-700\\">Light mode content</span>\\n      )}\\n    </div>\\n  );\\n}\\n```\\n\\n## TailwindCSS Dark Mode\\n\\nThe simplest way to create dark mode styles is with Tailwind\'s dark variant:\\n\\n```tsx\\nfunction DarkModeCard() {\\n  return (\\n    <div className=\\"bg-white dark:bg-gray-800 text-gray-900 dark:text-white p-4 rounded-md shadow-md\\">\\n      <h2 className=\\"text-xl font-bold text-primary-600 dark:text-primary-400\\">\\n        Dark Mode Compatible\\n      </h2>\\n      <p className=\\"mt-2 text-gray-600 dark:text-gray-300\\">\\n        This card adapts to your theme preference automatically.\\n      </p>\\n      <button className=\\"mt-4 bg-primary-500 hover:bg-primary-600 dark:bg-primary-600 dark:hover:bg-primary-700 text-white px-4 py-2 rounded\\">\\n        Action Button\\n      </button>\\n    </div>\\n  );\\n}\\n```\\n\\n## Handling Images in Dark Mode\\n\\nConditionally load appropriate images for the current theme:\\n\\n```tsx\\nfunction ThemeAwareImage() {\\n  const { resolvedTheme } = useTheme();\\n\\n  return (\\n    <img\\n      src={resolvedTheme === \'dark\'\\n        ? \'/images/logo-dark.svg\'\\n        : \'/images/logo-light.svg\'\\n      }\\n      alt=\\"Logo\\"\\n      className=\\"h-8 w-auto\\"\\n    />\\n  );\\n}\\n```\\n\\n## Preventing Hydration Mismatch\\n\\nSince theme information isn\'t available during server rendering, prevent hydration mismatches:\\n\\n```tsx\\nimport { useState, useEffect } from \'react\';\\nimport { useTheme } from \'next-themes\';\\n\\nfunction SafeThemeToggle() {\\n  const [mounted, setMounted] = useState(false);\\n  const { theme, setTheme } = useTheme();\\n\\n  // Wait for component to mount to access theme\\n  useEffect(() => {\\n    setMounted(true);\\n  }, []);\\n\\n  if (!mounted) {\\n    // Return placeholder with same dimensions\\n    return <div className=\\"w-8 h-8\\" />;\\n  }\\n\\n  return (\\n    <button\\n      className=\\"w-8 h-8 rounded-full flex items-center justify-center\\"\\n      onClick={() => setTheme(theme === \'dark\' ? \'light\' : \'dark\')}\\n    >\\n      {theme === \'dark\' ? \'☀️\' : \'\uD83C\uDF19\'}\\n    </button>\\n  );\\n}\\n```\\n\\n## Dark Mode with CSS Variables\\n\\nAccess theme variables within your components:\\n\\n```tsx\\nfunction ThemedComponent() {\\n  return (\\n    <div\\n      style={{\\n        backgroundColor: \'var(--background)\',\\n        color: \'var(--foreground)\',\\n        borderColor: \'var(--border)\'\\n      }}\\n      className=\\"p-4 border rounded\\"\\n    >\\n      <h3 className=\\"font-medium\\">Using CSS Variables</h3>\\n      <p>This component uses theme CSS variables.</p>\\n    </div>\\n  );\\n}\\n```\\n","code":"var Component=(()=>{var p=Object.create;var c=Object.defineProperty;var E=Object.getOwnPropertyDescriptor;var y=Object.getOwnPropertyNames;var m=Object.getPrototypeOf,F=Object.prototype.hasOwnProperty;var u=(l,e)=>()=>(e||l((e={exports:{}}).exports,e),e.exports),g=(l,e)=>{for(var s in e)c(l,s,{get:e[s],enumerable:!0})},o=(l,e,s,a)=>{if(e&&typeof e==\\"object\\"||typeof e==\\"function\\")for(let r of y(e))!F.call(l,r)&&r!==s&&c(l,r,{get:()=>e[r],enumerable:!(a=E(e,r))||a.enumerable});return l};var N=(l,e,s)=>(s=l!=null?p(m(l)):{},o(e||!l||!l.__esModule?c(s,\\"default\\",{value:l,enumerable:!0}):s,l)),x=l=>o(c({},\\"__esModule\\",{value:!0}),l);var t=u((f,i)=>{i.exports=_jsx_runtime});var B={};g(B,{default:()=>h,frontmatter:()=>k});var n=N(t()),k={title:\\"Dark Mode\\",description:\\"How to use dark mode features in Metronic React.\\"};function d(l){let e={a:\\"a\\",code:\\"code\\",div:\\"div\\",h2:\\"h2\\",line:\\"line\\",p:\\"p\\",pre:\\"pre\\",span:\\"span\\",svg:\\"svg\\",...l.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsxs)(e.p,{children:[\\"Metronic React provides built-in dark mode support using \\",(0,n.jsx)(e.a,{href:\\"https://github.com/pacocoursey/next-themes\\",children:\\"next-themes\\"}),\\". For details on the theme provider implementation, see the \\",(0,n.jsx)(e.a,{href:\\"/metronic-react/guides/providers\\",children:\\"Providers guide\\"}),\\".\\"]}),`\\n`,(0,n.jsxs)(e.h2,{id:\\"basic-usage\\",children:[(0,n.jsx)(e.a,{className:\\"heading\\",\\"aria-label\\":\\"Link to section\\",href:\\"#basic-usage\\",children:(0,n.jsxs)(e.svg,{xmlns:\\"http://www.w3.org/2000/svg\\",width:\\"16\\",height:\\"16\\",viewBox:\\"0 0 24 24\\",fill:\\"none