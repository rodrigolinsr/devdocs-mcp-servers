'react-router-dom\';\\nimport { AppRoutingSetup } from \'./app-routing-setup\';\\nimport TopBarProgress from \'react-top-loading-bar\';\\nimport { useProgress } from \'@/hooks/use-progress\';\\n\\nconst Routing = () => {\\n  const { progress } = useProgress();\\n  const routes = useRoutes(AppRoutingSetup());\\n\\n  return (\\n    <>\\n      <TopBarProgress\\n        color=\'#4338ca\'\\n        progress={progress}\\n      />\\n      <Suspense fallback={<div>Loading...</div>}>\\n        {routes}\\n      </Suspense>\\n    </>\\n  );\\n};\\n\\nexport function AppRouting() {\\n  return (\\n    <BrowserRouter basename=\\"/metronic/tailwind/react\\">\\n      <Routing />\\n    </BrowserRouter>\\n  );\\n}\\n```\\n\\nNote the `basename` prop in `BrowserRouter`, which sets the base URL for all routes. This matches the `base` configuration in `vite.config.ts`.\\n\\n## Route Definitions\\n\\nRoutes are defined in `src/routing/app-routing-setup.tsx`:\\n\\n```tsx\\n// src/routing/app-routing-setup.tsx\\nimport { ReactElement } from \'react\';\\nimport { Navigate, Route, Routes } from \'react-router\';\\nimport { DefaultPage } from \'@/pages/dashboards\';\\nimport { RequireAuth } from \'@/auth/require-auth\';\\nimport { Demo3Layout } from \'@/layouts/demo3/layout\';\\nimport { ErrorRouting } from \'@/errors/error-routing\';\\nimport { AuthRouting } from \'@/auth/auth-routing\';\\n\\nconst AppRoutingSetup = (): ReactElement => {\\n  return (\\n    <Routes>\\n      <Route element={<RequireAuth />}>\\n        <Route element={<Demo3Layout />}>\\n          <Route path=\\"/\\" element={<DefaultPage />} />\\n          {/* Other protected routes... */}\\n        </Route>\\n      </Route>\\n      <Route path=\\"error/*\\" element={<ErrorRouting />} />\\n      <Route path=\\"auth/*\\" element={<AuthRouting />} />\\n      <Route path=\\"*\\" element={<Navigate to=\\"/error/404\\" />} />\\n    </Routes>\\n  );\\n};\\n\\nexport { AppRoutingSetup };\\n```\\n\\n## Protected Routes\\n\\nRoutes that require authentication are wrapped with the `RequireAuth` component:\\n\\n```tsx\\n// src/auth/require-auth.tsx\\nimport { useEffect } from \'react\';\\nimport { useNavigate, Outlet } from \'react-router-dom\';\\nimport { useAuth } from \'./use-auth\';\\n\\nexport function RequireAuth() {\\n  const { currentUser, isLoading } = useAuth();\\n  const navigate = useNavigate();\\n\\n  useEffect(() => {\\n    if (!isLoading && !currentUser) {\\n      navigate(\'/auth/login\');\\n    }\\n  }, [currentUser, isLoading, navigate]);\\n\\n  return currentUser ? <Outlet /> : null;\\n}\\n```\\n\\n## Authentication Routes\\n\\nAuthentication routes are defined in `src/auth/auth-routing.tsx`:\\n\\n```tsx\\n// src/auth/auth-routing.tsx\\nimport { lazy } from \'react\';\\nimport { Routes, Route, Navigate } from \'react-router-dom\';\\nimport { AuthLayout } from \'@/layouts/auth/layout\';\\n\\nconst LoginPage = lazy(() => import(\'@/pages/auth/login-page\'));\\nconst RegisterPage = lazy(() => import(\'@/pages/auth/register-page\'));\\nconst ForgotPasswordPage = lazy(() => import(\'@/pages/auth/forgot-password-page\'));\\n\\nexport function AuthRouting() {\\n  return (\\n    <Routes>\\n      <Route element={<AuthLayout />}>\\n        <Route path=\\"login\\" element={<LoginPage />} />\\n        <Route path=\\"register\\" element={<RegisterPage />} />\\n        <Route path=\\"forgot-password\\" element={<ForgotPasswordPage />} />\\n        <Route path=\\"*\\" element={<Navigate to=\\"/auth/login\\" />} />\\n      </Route>\\n    </Routes>\\n  );\\n}\\n```\\n\\n## Using Layouts\\n\\nLayouts are used to provide a consistent UI structure for multiple routes. In Metronic React, layouts are implemented as route wrappers:\\n\\n```tsx\\n// src/layouts/demo3/layout.tsx\\nimport { Outlet } from \'react-router-dom\';\\nimport { Header } from \'./components/header\';\\nimport { Sidebar } from \'./components/sidebar\';\\nimport { Footer } from \'./components/footer\';\\n\\nexport function Demo3Layout() {\\n  return (\\n    <div className=\\"layout\\">\\n      <Header />\\n      <div className=\\"flex\\">\\n        <Sidebar />\\n        <main className=\\"content\\">\\n          <Outlet />\\n        </main>\\n      </div>\\n      <Footer />\\n    </div>\\n  );\\n}\\n```\\n\\nThe `Outlet` component is where the matched route content will be rendered.\\n\\n## Navigation\\n\\n### Link Component\\n\\nFor navigation between routes, use the `Link` component from React Router:\\n\\n```tsx\\nimport { Link } from \'react-router-dom\';\\n\\n// Basic link\\n<Link to=\\"/dashboard\\">Dashboard</Link>\\n\\n// Link with state\\n<Link\\n  to=\\"/profile\\"\\n  state={{ from: \'dashboard\' }}\\n>\\n  Profile\\n</Link>\\n```\\n\\n### Programmatic Navigation\\n\\nFor programmatic navigation (e.g., after form submission), use the `useNavigate` hook:\\n\\n```tsx\\nimport { useNavigate } from \'react-router-dom\';\\n\\nfunction LoginForm() {\\n  const navigate = useNavigate();\\n\\n  const handleLogin = async (formData) => {\\n    // Login logic...\\n    if (success) {\\n      navigate(\'/dashboard\');\\n    }\\n  };\\n\\n  // ...\\n}\\n```\\n\\n## Route Parameters\\n\\nYou can define dynamic routes with parameters:\\n\\n```tsx\\n// In app-routing-setup.tsx\\n<Route path=\\"/profile/:id\\" element={<ProfilePage />} />\\n\\n// In ProfilePage component\\nimport { useParams } from \'react-router-dom\';\\n\\nfunction ProfilePage() {\\n  const { id } = useParams();\\n\\n  // Use the id parameter\\n  return <div>Profile ID: {id}</div>;\\n}\\n```\\n\\n## Nested Routes\\n\\nNested routes allow you to organize related routes:\\n\\n```tsx\\n// In app-routing-setup.tsx\\n<Route path=\\"/settings\\" element={<SettingsLayout />}>\\n  <Route index element={<GeneralSettings />} />\\n  <Route path=\\"profile\\" element={<ProfileSettings />} />\\n  <Route path=\\"security\\" element={<SecuritySettings />} />\\n</Route>\\n\\n// In SettingsLayout component\\nimport { Outlet } from \'react-router-dom\';\\n\\nfunction SettingsLayout() {\\n  return (\\n    <div className=\\"settings-layout\\">\\n      <SettingsSidebar />\\n      <div className=\\"settings-content\\">\\n        <Outlet />\\n      </div>\\n    </div>\\n  );\\n}\\n```\\n\\n## Route Meta Data\\n\\nTo associate meta data with routes, you can create a route configuration object:\\n\\n```tsx\\n// src/routing/routes.ts\\nexport const routes = [\\n  {\\n    path: \'/\',\\n    element: <DefaultPage />,\\n    meta: {\\n      title: \'Dashboard\',\\n      breadcrumb: \'Home\'\\n    }\\n  },\\n  {\\n    path: \'/profile\',\\n    element: <ProfilePage />,\\n    meta: {\\n      title: \'User Profile\',\\n      breadcrumb: \'Profile\'\\n    }\\n  }\\n];\\n```\\n\\nThen use this configuration to generate routes and access meta data:\\n\\n```tsx\\n// Example usage in a component\\nimport { useLocation } from \'react-router-dom\';\\nimport { routes } from \'@/routing/routes\';\\n\\nfunction PageTitle() {\\n  const location = useLocation();\\n  const route = routes.find(r => r.path === location.pathname);\\n  const title = route?.meta?.title || \'Metronic\';\\n\\n  return <h1>{title}</h1>;\\n}\\n```\\n\\n## Error Routes\\n\\nError routes are defined in `src/errors/error-routing.tsx` and handle various error states:\\n\\n```tsx\\n// src/errors/error-routing.tsx\\nimport { lazy } from \'react\';\\nimport { Routes, Route, Navigate } from \'react-router-dom\';\\nimport { ErrorLayout } from \'@/layouts/error/layout\';\\n\\nconst Error404Page = lazy(() => import(\'@/pages/errors/error-404-page\'));\\nconst Error500Page = lazy(() => import(\'@/pages/errors/error-500-page\'));\\n\\nexport function ErrorRouting() {\\n  return (\\n    <Routes>\\n      <Route element={<ErrorLayout />}>\\n        <Route path=\\"404\\" element={<Error404Page />} />\\n        <Route path=\\"500\\" element={<Error500Page />} />\\n        <Route path=\\"*\\" element={<Navigate to=\\"/error/404\\" />} />\\n      </Route>\\n    </Routes>\\n  );\\n}\\n```\\n\\n## Loading Indicator\\n\\nMetronic React includes a top loading bar to show route navigation progress:\\n\\n```tsx\\n// Usage in app-routing.tsx\\nimport TopBarProgress from \'react-top-loading-bar\';\\nimport { useProgress } from \'@/hooks/use-progress\';\\n\\nconst Routing = () => {\\n  const { progress } = useProgress();\\n\\n  return (\\n    <>\\n      <TopBarProgress\\n        color=\'#4338ca\'\\n        progress={progress}\\n      />\\n      {/* Routes */}\\n    </>\\n  );\\n};\\n```\\n\\nFor more details, see the source code in the `src/routing` directory.","code":"var Component=(()=>{var p=Object.create;var o=Object.defineProperty;var E=Object.getOwnPropertyDescriptor;var y=Object.getOwnPropertyNames;var u=Object.getPrototypeOf,m=Object.prototype.hasOwnProperty;var F=(l,e)=>()=>(e||l((e={exports:{}}).exports,e),e.exports),g=(l,e)=>{for(var r in e)o(l,r,{get:e[r],enumerable:!0})},a=(l,e,r,c)=>{if(e&&typeof e==\\"object\\"||typeof e==\\"function\\")for(let s of y(e))!m.call(l,s)&&s!==r&&o(l,s,{get:()=>e[s],enumerable:!(c=E(e,s))||c.enumerable});return l};var N=(l,e,r)=>(r=l!=null?p(u(l)):{},a(e||!l||!l.__esModule?o(r,\\"default\\",{value:l,enumerable:!0}):r,l)),B=l=>a(o({},\\"__esModule\\",{value:!0}),l);var i=F((w,t)=>{t.exports=_jsx_runtime});var x={};g(x,{default:()=>h,frontmatter:()=>f});var n=N(i()),f={title:\\"Routing\\",description:\\"Learn how to use and customize the routing system in Metronic React.\\"};function d(l){let e={a:\\"a\\",code:\\"code\\",div:\\"div\\",h2:\\"h2\\",h3:\\"h3\\",li:\\"li\\",line:\\"line\\",ol:\\"ol\\",p:\\"p\\",pre:\\"pre\\",span:\\"span\\",strong:\\"strong\\",svg:\\"svg\\",...l.components};return(0,n.jsxs)(n.Fragment,{children:[(0,n.jsx)(e.p,{children:\\"Metronic React uses React Router v7 for handling navigation between different pages. This guide explains the routing system architecture and how to work with it.\\"}),`\\n`,(0,n.jsxs)(e.h2,{id:\\"routing-architecture\\",children:[(0,n.jsx)(e.a,{className:\\"heading