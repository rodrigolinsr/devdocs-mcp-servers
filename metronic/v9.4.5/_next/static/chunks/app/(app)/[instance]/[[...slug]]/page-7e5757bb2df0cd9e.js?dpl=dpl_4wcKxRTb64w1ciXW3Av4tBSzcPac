\n\\\\u251C\\\\u2500\\\\u2500 (protected)/                # Uses Demo1Layout\\n\\\\u2502   \\\\u2514\\\\u2500\\\\u2500 account/                # Uses AccountLayout (wraps Demo1Layout)\\n\\\\u2502       \\\\u2514\\\\u2500\\\\u2500 settings/           # Uses SettingsLayout (wraps AccountLayout)\\n`})}),`\\n`,(0,n.jsxs)(e.p,{children:[\\"For more information about layouts in Next.js, refer to the \\",(0,n.jsx)(e.a,{href:\\"https://nextjs.org/docs/app/building-your-application/routing/pages-and-layouts\\",children:\\"official documentation\\"}),\\".\\"]})]})}function h(l={}){let{wrapper:e}=l.components||{};return e?(0,n.jsx)(e,{...l,children:(0,n.jsx)(d,{...l})}):d(l)}return N(w);})();\\n;return Component;"},"_id":"storely/guides/layouts.mdx","_raw":{"sourceFilePath":"storely/guides/layouts.mdx","sourceFileName":"layouts.mdx","sourceFileDir":"storely/guides","contentType":"mdx","flattenedPath":"storely/guides/layouts"},"type":"Doc","slug":"/storely/guides/layouts","slugAsParams":"storely/guides/layouts","instance":"storely"},{"title":"Providers","description":"Understanding and using context providers in Storely","published":true,"featured":false,"component":false,"toc":true,"body":{"raw":"\\n# Providers\\n\\nStorely uses a collection of context providers to manage application state and functionality. This guide explains each provider, its purpose, and how to use it in your application.\\n\\n## Provider Architecture\\n\\nProviders are organized in a nested structure in the root layout, giving all components access to their contexts:\\n\\n```tsx\\n// app/layout.tsx\\nimport { AuthProvider } from \'@/providers/auth-provider\';\\nimport { I18nProvider } from \'@/providers/i18n-provider\';\\nimport { QueryProvider } from \'@/providers/query-provider\';\\nimport { SettingsProvider } from \'@/providers/settings-provider\';\\nimport { ThemeProvider } from \'@/providers/theme-provider\';\\nimport { TooltipsProvider } from \'@/providers/tooltips-provider\';\\n\\nexport default function RootLayout({\\n  children,\\n}: {\\n  children: React.ReactNode;\\n}) {\\n  return (\\n    <html className=\\"h-full\\" suppressHydrationWarning>\\n      <body>\\n        <QueryProvider>\\n          <AuthProvider>\\n            <SettingsProvider>\\n              <ThemeProvider>\\n                <I18nProvider>\\n                  <TooltipsProvider>\\n                    {children}\\n                    <Toaster />\\n                  </TooltipsProvider>\\n                </I18nProvider>\\n              </ThemeProvider>\\n            </SettingsProvider>\\n          </AuthProvider>\\n        </QueryProvider>\\n      </body>\\n    </html>\\n  );\\n}\\n```\\n\\n## Core Providers\\n\\n### Query Provider\\n\\nProvides TanStack Query functionality for data fetching and caching.\\n\\n**Usage:**\\n\\n```tsx\\n\'use client\';\\n\\nimport { useQuery } from \'@tanstack/react-query\';\\n\\nfunction UserProfile({ userId }: { userId: string }) {\\n  const { data, isLoading, error } = useQuery({\\n    queryKey: [\'user\', userId],\\n    queryFn: () => fetch(`/api/users/${userId}`).then(res => res.json())\\n  });\\n\\n  if (isLoading) return <div>Loading...</div>;\\n  if (error) return <div>Error loading user</div>;\\n\\n  return <div><h1>{data.name}</h1><p>{data.email}</p></div>;\\n}\\n```\\n\\n### Auth Provider\\n\\nWraps NextAuth.js SessionProvider to handle authentication state.\\n\\n**Usage:**\\n\\n```tsx\\n\'use client\';\\n\\nimport { useSession, signIn, signOut } from \'next-auth/react\';\\n\\nfunction LoginButton() {\\n  const { data: session } = useSession();\\n\\n  if (session) {\\n    return <button onClick={() => signOut()}>Sign out</button>;\\n  }\\n  return <button onClick={() => signIn()}>Sign in</button>;\\n}\\n```\\n\\n### Settings Provider\\n\\nManages application settings with localStorage persistence.\\n\\n**Usage:**\\n\\n```tsx\\n\'use client\';\\n\\nimport { useSettings } from \'@/providers/settings-provider\';\\n\\nfunction LayoutSettings() {\\n  const { getOption, storeOption } = useSettings();\\n\\n  // Get a setting\\n  const sidebarCollapsed = getOption(\'layouts.demo1.sidebarCollapse\');\\n\\n  // Update a setting (and save to localStorage)\\n  function toggleSidebar() {\\n    storeOption(\'layouts.demo1.sidebarCollapse\', !sidebarCollapsed);\\n  }\\n\\n  return <button onClick={toggleSidebar}>\\n    {sidebarCollapsed ? \'Expand\' : \'Collapse\'} Sidebar\\n  </button>;\\n}\\n```\\n\\n### Theme Provider\\n\\nManages dark/light mode using next-themes.\\n\\n**Usage:**\\n\\n```tsx\\n\'use client\';\\n\\nimport { useTheme } from \'next-themes\';\\n\\nfunction ThemeToggle() {\\n  const { theme, setTheme } = useTheme();\\n\\n  return (\\n    <button onClick={() => setTheme(theme === \'dark\' ? \'light\' : \'dark\')}>\\n      Switch to {theme === \'dark\' ? \'Light\' : \'Dark\'} Mode\\n    </button>\\n  );\\n}\\n```\\n\\n### I18n Provider\\n\\nManages internationalization and RTL support.\\n\\n**Usage:**\\n\\n```tsx\\n\'use client\';\\n\\nimport { useLanguage } from \'@/providers/i18n-provider\';\\nimport { I18N_LANGUAGES } from \'@/i18n/config\';\\n\\nfunction LanguageSelector() {\\n  const { languageCode, changeLanguage } = useLanguage();\\n\\n  return (\\n    <select\\n      value={languageCode}\\n      onChange={(e) => changeLanguage(e.target.value)}\\n    >\\n      {I18N_LANGUAGES.map(lang => (\\n        <option key={lang.code} value={lang.code}>\\n          {lang.name}\\n        </option>\\n      ))}\\n    </select>\\n  );\\n}\\n```\\n\\n### Tooltips Provider\\n\\nProvides tooltip functionality for the application.\\n\\n**Usage:**\\n\\n```tsx\\n\'use client\';\\n\\nimport {\\n  Tooltip,\\n  TooltipContent,\\n  TooltipTrigger,\\n} from \'@/components/ui/tooltip\';\\n\\nfunction ButtonWithTooltip() {\\n  return (\\n    <Tooltip>\\n      <TooltipTrigger asChild>\\n        <button>Hover me</button>\\n      </TooltipTrigger>\\n      <TooltipContent>\\n        <p>Tooltip content</p>\\n      </TooltipContent>\\n    </Tooltip>\\n  );\\n}\\n```\\n\\n## Creating Custom Hooks\\n\\nFor components that need access to multiple contexts, combine the hooks in a custom hook:\\n\\n```tsx\\n\'use client\';\\n\\nimport { useSettings } from \'@/providers/settings-provider\';\\nimport { useLanguage } from \'@/providers/i18n-provider\';\\nimport { useTheme } from \'next-themes\';\\n\\n// Custom hook combining multiple contexts\\nexport function useAppContext() {\\n  const settings = useSettings();\\n  const language = useLanguage();\\n  const theme = useTheme();\\n\\n  return { settings, language, theme };\\n}\\n\\n// Usage\\nfunction MyComponent() {\\n  const { settings, language, theme } = useAppContext();\\n\\n  return (\\n    <div>\\n      <p>Current theme: {theme.theme}</p>\\n      <p>Current language: {language.languageCode}</p>\\n      <p>Layout: {settings.getOption(\'layout\')}</p>\\n    </div>\\n  );\\n}\\n```\\n\\n## Provider-Specific Documentation\\n\\nFor more detailed information about each provider, refer to these guides:\\n\\n- [Authentication](/storely/guides/authentication) - Using the Auth Provider\\n- [Internationalization](/storely/guides/internationalization) - Using the I18n Provider\\n- [Dark Mode](/storely/guides/dark-mode) - Using the Theme Provider\\n- [RTL Support](/storely/guides/rtl) - RTL features with I18n Provider\\n","code":"var Component=(()=>{var p=Object.create;var o=Object.defineProperty;var E=Object.getOwnPropertyDescriptor;var y=Object.getOwnPropertyNames;var m=Object.getPrototypeOf,u=Object.prototype.hasOwnProperty;var g=(l,e)=>()=>(e||l((e={exports:{}}).exports,e),e.exports),F=(l,e)=>{for(var s in e)o(l,s,{get:e[s],enumerable:!0})},i=(l,e,s,c)=>{if(e&&typeof e==\\"object\\"||typeof e==\\"function\\")for(let r of y(e))!u.call(l,r)&&r!==s&&o(l,r,{get:()=>e[r],enumerable:!(c=E(e,r))||c.enumerable});return l};var N=(l,e,s)=>(s=l!=null?p(m(l)):{},i(e||!l||!l.__esModule?o(s,\\"default\\",{value:l,enumerable:!0}):s,l)),v=l=>i(o({},\\"__esModule\\",{value:!0})