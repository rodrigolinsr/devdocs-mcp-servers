\\n# Database\\nDATABASE_URL=\\"postgresql://user:password@localhost:5432/shoplit\\"\\n\\n# NextAuth\\nNEXTAUTH_URL=\\"http://localhost:3000\\"\\nNEXTAUTH_SECRET=\\"your-secret-key\\"\\n\\n# OAuth (Optional)\\nGOOGLE_CLIENT_ID=\\"your-client-id\\"\\nGOOGLE_CLIENT_SECRET=\\"your-client-secret\\"\\n\\n# Storage\\nSTORAGE_TYPE=\\"digitalocean\\"  # or \\"s3\\"\\nSTORAGE_ACCESS_KEY_ID=\\"your-access-key\\"\\nSTORAGE_SECRET_ACCESS_KEY=\\"your-secret-key\\"\\nSTORAGE_REGION=\\"your-region\\"\\nSTORAGE_BUCKET=\\"your-bucket\\"\\n```\\n\\n### Development Server\\n\\nStart the development server with Turbopack:\\n\\n```bash\\nnpm run dev\\n```\\n\\nYour application will be available at `http://localhost:3000`\\n\\n### Additional Commands\\n\\n- **Format Code**:\\n```bash\\nnpm run format\\n```\\n\\n- **Lint Code**:\\n```bash\\nnpm run lint\\n```\\n\\n- **Production Build**:\\n```bash\\nnpm run build\\n```\\n\\n- **Start Production Server**:\\n```bash\\nnpm run start\\n```\\n</Steps>\\n","code":"var Component=(()=>{var p=Object.create;var i=Object.defineProperty;var y=Object.getOwnPropertyDescriptor;var u=Object.getOwnPropertyNames;var g=Object.getPrototypeOf,m=Object.prototype.hasOwnProperty;var E=(l,e)=>()=>(e||l((e={exports:{}}).exports,e),e.exports),x=(l,e)=>{for(var r in e)i(l,r,{get:e[r],enumerable:!0})},s=(l,e,r,t)=>{if(e&&typeof e==\\"object\\"||typeof e==\\"function\\")for(let a of u(e))!m.call(l,a)&&a!==r&&i(l,a,{get:()=>e[a],enumerable:!(t=y(e,a))||t.enumerable});return l};var f=(l,e,r)=>(r=l!=null?p(g(l)):{},s(e||!l||!l.__esModule?i(r,\\"default\\",{value:l,enumerable:!0}):r,l)),w=l=>s(i({},\\"__esModule\\",{value:!0}),l);var c=E((N,o)=>{o.exports=_jsx_runtime});var v={};x(v,{default:()=>h,frontmatter:()=>F});var n=f(c()),F={title:\\"Installation\\",description:\\"Get started with Shoplit quickly by following this guide.\\"};function d(l){let e={a:\\"a\\",code:\\"code\\",div:\\"div\\",h1:\\"h1\\",h2:\\"h2\\",h3:\\"h3\\",li:\\"li\\",line:\\"line\\",ol:\\"ol\\",p:\\